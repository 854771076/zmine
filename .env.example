# ZMINE 系统配置示例
# 复制此文件为 .env 并修改配置

# 网站配置
SITE_URL=https://zmine.si
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2

# 并发配置
MAX_CONCURRENT=10
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0

# 数据库配置
DB_PATH=zmine.db

# 任务配置
TASK_DEFAULT_PRIORITY=5
TASK_MAX_RETRIES=3

# Web UI配置
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=False

# 邀请配置
INVITE_MAX_LEVEL=2
INVITE_REWARD_RATE=0.1

# 反检测配置
USE_RANDOM_UA=True
AUTO_ROTATE_PROXY=False
# 代理配置，支持HTTP/SOCKS5代理
# PROXY_URL=http://user:pass@proxy:port
# PROXY_URL=socks5://user:pass@proxy:port
PROXY_URL=

# 定时任务配置
# 自动挖矿间隔（分钟）
MINING_INTERVAL=60
# 自动领取奖励间隔（分钟）
CLAIM_INTERVAL=240
# 自动完成任务间隔（分钟）
TASK_INTERVAL=360
# 自动同步账号信息间隔（分钟）
SYNC_INTERVAL=120